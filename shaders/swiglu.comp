#version 450
// The gated unit of the SwiGLU feed-forward over rows of `2 * width`
// values, up then gate: `up * silu(gate)` into the first `width` of each.
// A row of workgroups per row.
layout(local_size_x = 256) in;

layout(std430, binding = 0) restrict buffer X { float x[]; };
layout(push_constant) uniform PC {
    uint width;
} pc;

void main() {
    uint col = gl_GlobalInvocationID.x;
    if (col >= pc.width)
        return;
    uint at = gl_WorkGroupID.y * 2 * pc.width + col;
    float gate = x[at + pc.width];
    x[at] *= gate / (1.0 + exp(-gate));
}
